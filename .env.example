# Create an API key at https://console.x.ai/, then copy this file to .env.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.6
# Grok 4.6 supports image understanding as well as text.
XAI_VISION_MODEL=grok-4.6

# Neon PostgreSQL connection. Keep this value private in .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET_KEY="replace-with-a-random-secret-at-least-32-characters-long"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173

